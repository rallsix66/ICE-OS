# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code runtime
.claude/context-status.json
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Python cache
__pycache__/

# BigSeller scraper local session and captured data
tools/bigseller-scraper/runtime/

# Claude Code local pgdata
.claude/pgdata-p5-sy5g/

# P0-01 local isolated postgres runtime (binaries, pgdata, secrets, evidence)
.local/p0-01/

# P0-02 local isolated postgres runtime (binaries, pgdata, secrets, evidence)
.local/p0-02/

# P0-03 local sample workbooks, match evidence, review outcomes
.local/p0-03/

# Catalog isolated runs, local preview pgdata, secrets, and evidence
.local/catalog/

# Local clone of emilkowalski/skills (nested git); register version in archive manifest only
.local/skills-emilkowalski/

# Local discovery, desktop cleanup, and ad-hoc preview logs (keep on disk only)
.local/product-library-discovery/
.local/desktop-cleanup/
.local/preview-*/

# Local runtime noise
debug.log
